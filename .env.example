# No Replit, a aba "Database" cria isso automaticamente ao provisionar
# um banco PostgreSQL — você não precisa preencher nada manualmente lá.
#
# Para rodar localmente, copie este arquivo para ".env" e preencha com
# a URL de conexão do seu PostgreSQL:
DATABASE_URL=postgresql://usuario:senha@localhost:5432/vinhos

# Porta do servidor (opcional, padrão 3000)
PORT=3000

# Credenciais da área administrativa (/admin).
# Sem essas três variáveis, as rotas de criar/editar/excluir/restaurar
# ficam bloqueadas com erro 503 — a loja em modo leitura continua normal.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
